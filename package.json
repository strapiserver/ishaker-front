{
  "name": "ishaker-front",
  "private": true,
  "scripts": {
    "clean": "npm run clean:build && npm run clean:dev",
    "clean:build": "node -e \"require('fs').rmSync('.next',{recursive:true,force:true})\"",
    "clean:dev": "node -e \"require('fs').rmSync('.next-dev',{recursive:true,force:true})\"",
    "predev": "npm run clean:dev",
    "dev": "next dev -p 3000",
    "prebuild": "npm run clean:build",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "test": "tsx --test lib/**/*.test.ts"
  },
  "dependencies": {
    "@chakra-ui/react": "^2.8.0",
    "@chakra-ui/theme-tools": "^2.1.0",
    "@emotion/react": "^11",
    "@emotion/styled": "^11",
    "@lottiefiles/dotlottie-react": "^0.17.10",
    "@next/bundle-analyzer": "^13.3.0",
    "@reduxjs/toolkit": "^2.12.0",
    "@types/formidable": "^3.4.5",
    "formidable": "^3.5.4",
    "framer-motion": "^6",
    "libphonenumber-js": "1.13.10",
    "next": "13.5.3",
    "next-seo": "^6.5.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-icons": "5.4.0",
    "react-is": "18.3.1",
    "react-markdown": "^6.0.3",
    "react-qr-code": "^2.2.0",
    "react-redux": "^9.3.0",
    "recharts": "^3.9.1",
    "remark-gfm": "^1.0.0",
    "swr": "^2.4.2"
  },
  "devDependencies": {
    "@types/node": "^20.12.7",
    "@types/react": "^18.2.75",
    "eslint": "8.8.0",
    "eslint-config-next": "12.0.10",
    "tsx": "^4.23.12",
    "typescript": "^5.4.5"
  }
}
